# Copy to .env. Never commit real values.
LOCAL_DEVELOPMENT=true
APP_ORIGIN=http://localhost:3000
ARTIFACT_ORIGIN=http://127.0.0.1:3001
PORT=3000
ARTIFACT_PORT=3001
DATA_DIR=.data
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Use your own repository, preferably private for company artifacts.
GITHUB_REPOSITORY=john9806/artifact-hub
# A dedicated bot user's fine-grained PAT: contents RW, pull requests RW, commit statuses RW.
# The bot needs access to this repository. Do not use a reviewer's account as the bot.
GITHUB_TOKEN=
# GitHub OAuth App callback: http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=john9806
GITHUB_WRITERS=john9806
# Add a DIFFERENT reviewer who can review this repository's PRs.
GITHUB_REVIEWERS=

# Optional. The REST base URL should end with /cubejs-api/v1.
# CUBE_API_URL=https://cube.example.com/cubejs-api/v1
# CUBE_API_SECRET=
# CUBE_ALLOWED_MEMBERS=Orders.count,Orders.revenue,Orders.createdAt
